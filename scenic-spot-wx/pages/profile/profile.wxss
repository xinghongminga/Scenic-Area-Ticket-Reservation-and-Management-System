.profile {
  display: grid;
  gap: 12rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.label {
  font-size: 24rpx;
  color: #64748b;
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #e2e8f0;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #334155;
  font-size: 24rpx;
}

.tip {
  color: #0f766e;
  font-size: 24rpx;
}

.readonly {
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  padding: 14rpx;
  color: #475569;
  background: #f8fafc;
  font-size: 26rpx;
}

.btn.ghost {
  background: #e2e8f0;
  color: #0f172a;
}

.input {
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  padding: 14rpx;
  background: #fff;
  font-size: 26rpx;
  color: #0f172a;
}

.btn.danger {
  background: #ef4444;
  color: #fff;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 28rpx;
  box-sizing: border-box;
}

.modal-card {
  width: 100%;
  max-height: 80vh;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  display: grid;
  gap: 16rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.modal-actions {
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}
