<view class="page">
  <view class="card profile">
    <view class="label">头像</view>
    <view class="avatar-row" bindtap="chooseAvatar">
      <image wx:if="{{avatarUrl}}" class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-fallback">头像</view>
      <view class="tip">点击更换头像</view>
    </view>

    <view class="label">手机号</view>
    <input class="input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />

    <view class="label">昵称</view>
    <input class="input" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />

    <button class="btn" bindtap="saveProfile">保存资料</button>
  </view>

  <view class="card profile">
    <view class="title">账号安全</view>
    <button class="btn ghost" bindtap="openPasswordModal">修改密码</button>
  </view>

  <view class="card">
    <button class="btn danger" bindtap="logout">退出登录</button>
  </view>

  <view wx:if="{{passwordModalVisible}}" class="modal-mask" bindtap="closePasswordModal">
    <view class="modal-card" catchtap="noop">
      <view class="modal-title">修改密码</view>
      <input class="input" password placeholder="原密码" value="{{oldPassword}}" bindinput="onOldPasswordInput" />
      <input class="input" password placeholder="新密码" value="{{newPassword}}" bindinput="onNewPasswordInput" />
      <view class="modal-actions">
        <button class="btn ghost" bindtap="closePasswordModal">取消</button>
        <button class="btn" bindtap="changePassword">确认修改</button>
      </view>
    </view>
  </view>
</view>
