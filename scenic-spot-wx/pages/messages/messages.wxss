.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  background: linear-gradient(135deg, #eff6ff, #ecfeff);
}

.hero-sub {
  font-size: 22rpx;
  color: #475569;
}

.badge {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #0f766e;
  color: #fff;
  font-size: 22rpx;
}

.toolbar {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.mini {
  flex: 1;
  border-radius: 999rpx;
  font-size: 24rpx;
  padding: 12rpx 20rpx;
  line-height: 1.2;
}

.mini.ghost {
  background: #e2e8f0;
  color: #0f172a;
}

.mini.primary {
  background: linear-gradient(90deg, #0f766e, #14b8a6);
  color: #fff;
}

.notice-item {
  display: grid;
  gap: 10rpx;
}

.notice-item.is-unread {
  border: 1rpx solid #99f6e4;
}

.notice-item.is-read {
  opacity: 0.84;
}

.notice-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.type-pill {
  display: inline-flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 20rpx;
  font-weight: 600;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ef4444;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.notice-content {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.6;
}

.notice-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.empty {
  margin-top: 80rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}