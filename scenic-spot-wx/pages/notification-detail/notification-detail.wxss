.detail-card {
  display: grid;
  gap: 18rpx;
  background: linear-gradient(180deg, #ffffff, #f8fafc);
}

.type-pill {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: fit-content;
  border-radius: 999rpx;
  padding: 8rpx 16rpx;
  background: #ecfeff;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 600;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.content-block {
  border-radius: 16rpx;
  background: #f8fafc;
  padding: 24rpx;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.8;
}

.empty {
  margin-top: 120rpx;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}