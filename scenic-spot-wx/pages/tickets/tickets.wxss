.head {
	display: flex;
	align-items: center;
	justify-content: space-between;
}

.search-bar {
	display: flex;
	align-items: center;
	gap: 10rpx;
}

.filter-bar {
	display: flex;
	align-items: center;
	gap: 12rpx;
}

.filter-label {
	font-size: 24rpx;
	color: #374151;
}

.filter-pill {
	background: #eff6ff;
	border: 1rpx solid #93c5fd;
	color: #1d4ed8;
	border-radius: 999rpx;
	padding: 10rpx 18rpx;
	font-size: 24rpx;
}

.search-input {
	flex: 1;
	border: 1rpx solid #d1d5db;
	border-radius: 12rpx;
	padding: 12rpx;
	background: #fff;
	font-size: 26rpx;
}

.mini {
	padding: 10rpx 16rpx;
	font-size: 24rpx;
	line-height: 1.2;
}

.date-pill {
	background: #fff7ed;
	border: 1rpx solid #fdba74;
	color: #9a3412;
	border-radius: 999rpx;
	padding: 10rpx 18rpx;
	font-size: 24rpx;
}

.goods {
	display: grid;
	grid-template-columns: 200rpx 1fr;
	gap: 16rpx;
}

.cover {
	width: 200rpx;
	height: 200rpx;
	border-radius: 14rpx;
	background: #e5e7eb;
}

.meta { display: grid; gap: 10rpx; }
.name { font-size: 30rpx; font-weight: 700; }
.sub { font-size: 22rpx; color: #6b7280; }

.price-line { display: flex; align-items: center; justify-content: space-between; }
.price { color: #dc2626; font-size: 36rpx; font-weight: 700; }

.qty {
	width: 120rpx;
	border: 1rpx solid #d1d5db;
	border-radius: 10rpx;
	padding: 6rpx 10rpx;
	text-align: center;
}

.action-row { display: flex; gap: 10rpx; }
.btn { flex: 1; }
.btn.ghost { background: #f1f5f9; color: #0f172a; }

.inventory {
	background: #ecfeff;
	color: #0e7490;
	border-radius: 10rpx;
	padding: 8rpx 10rpx;
	font-size: 22rpx;
}
