<view class="page">
  <view class="head card">
    <view class="title">景区门票</view>
    <picker mode="date" value="{{visitDate}}" start="{{minVisitDate}}" end="{{maxVisitDate}}" bindchange="onDateChange">
      <view class="date-pill">出行日期 {{visitDate}}</view>
    </picker>
  </view>

  <view class="card search-bar">
    <input class="search-input" placeholder="搜索门票名称" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="onSearch" />
    <button class="btn ghost mini" bindtap="onSearch">查询</button>
    <button class="btn ghost mini" bindtap="onResetSearch">重置</button>
  </view>

  <view class="card filter-bar">
    <view class="filter-label">门票类别</view>
    <picker mode="selector" range="{{ticketTypeOptions}}" range-key="label" value="{{ticketTypeIndex}}" bindchange="onTicketTypeChange">
      <view class="filter-pill">{{ticketTypeOptions[ticketTypeIndex].label}}</view>
    </picker>
  </view>

  <view class="goods card" wx:for="{{tickets}}" wx:key="id">
    <image class="cover" src="{{item.imageUrl || defaultTicketImage}}" mode="aspectFill" />
    <view class="meta">
      <view class="name">{{item.name}}</view>
      <view class="sub">{{item.ticketTypeText}} | 有效日期 {{item.validDate}}</view>
      <view class="sub">景区项目：{{item.projectNames}}</view>
      <view class="sub">可预订场次：{{item.slotHint}}</view>
      <view class="sub">上午库存：{{item.morningRemain === null ? '-' : item.morningRemain}}</view>
      <view class="sub">下午库存：{{item.afternoonRemain === null ? '-' : item.afternoonRemain}}</view>
      <view class="price-line">
        <text class="price">¥{{item.priceYuanText}}</text>
        <input class="qty" type="number" value="{{item.qtyText}}" data-id="{{item.id}}" bindinput="onQtyInput" />
      </view>
      <view class="action-row">
        <button class="btn ghost" data-id="{{item.id}}" bindtap="loadInventory">查库存</button>
        <button class="btn" data-id="{{item.id}}" bindtap="createOrder" loading="{{processingTicketId===item.id}}" disabled="{{processingTicketId===item.id}}">{{processingTicketId===item.id ? '提交中...' : '立即预订'}}</button>
      </view>
      <view wx:if="{{item.inventoryText}}" class="inventory">{{item.inventoryText}}</view>
    </view>
  </view>
</view>
