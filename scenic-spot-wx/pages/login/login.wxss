.login-page {
	min-height: 100vh;
	background: #f5f6f7;
	padding: 46rpx 34rpx;
	box-sizing: border-box;
}

.hero {
	display: flex;
	flex-direction: column;
	align-items: center;
	margin: 24rpx 0 28rpx;
}


.wechat-logo {
	width: 98rpx;
	height: 98rpx;
	border-radius: 50%;
	background: #07c160;
	color: #ffffff;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 48rpx;
	font-weight: 800;
	box-shadow: 0 12rpx 24rpx rgba(7, 193, 96, 0.24);
}

.brand-title {
	margin-top: 18rpx;
	font-size: 42rpx;
	font-weight: 700;
	color: #111827;
}

.brand-sub {
	margin-top: 8rpx;
	font-size: 24rpx;
	color: #6b7280;
}

.auth-card {
	background: #ffffff;
	border-radius: 24rpx;
	padding: 30rpx 28rpx;
	box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.06);
}

.mode-switch {
	display: flex;
	gap: 10rpx;
	margin-bottom: 24rpx;
	padding: 6rpx;
	background: #f3f4f6;
	border-radius: 999rpx;
}

.mode-pill {
	flex: 1;
	text-align: center;
	border-radius: 999rpx;
	border: 1rpx solid transparent;
	background: transparent;
	color: #6b7280;
	padding: 12rpx 0;
	font-size: 24rpx;
}

.mode-pill.active {
	border-color: #d1fae5;
	color: #065f46;
	background: #ffffff;
	font-weight: 600;
}

.field {
	margin-bottom: 20rpx;
}

.register-stepper {
	display: flex;
	align-items: center;
	margin: 6rpx 0 20rpx;
}

.step {
	font-size: 22rpx;
	color: #9ca3af;
}

.step.active {
	color: #111827;
	font-weight: 600;
}

.step.done {
	color: #059669;
	font-weight: 600;
}

.step-line {
	flex: 1;
	height: 2rpx;
	margin: 0 12rpx;
	background: #d1d5db;
}

.field-label {
	display: block;
	font-size: 24rpx;
	color: #6b7280;
	margin-bottom: 10rpx;
}

.field-input {
	width: 100%;
	box-sizing: border-box;
	border: 1rpx solid #d1d5db;
	border-radius: 12rpx;
	height: 98rpx;
	line-height: 98rpx;
	padding: 0 20rpx;
	background: #ffffff;
	font-size: 30rpx;
	color: #1f2937;
}

.field-input::placeholder {
	font-size: 28rpx;
	line-height: 98rpx;
	color: #9ca3af;
}

.code-row {
	display: flex;
	gap: 12rpx;
	align-items: center;
	margin-bottom: 8rpx;
}

.code-field {
	flex: 1;
	margin-bottom: 0;
}

.code-btn {
	width: 200rpx;
	height: 92rpx;
	line-height: 92rpx;
	border-radius: 12rpx;
	border: 1rpx solid #bfe8cf;
	background: #ecfdf3;
	color: #059669;
	font-size: 24rpx;
}

.method-tip {
	margin-top: -6rpx;
	margin-bottom: 18rpx;
	font-size: 22rpx;
	color: #07c160;
}

.register-actions {
	margin-top: 8rpx;
}

.register-actions.dual {
	display: grid;
	grid-template-columns: 180rpx 1fr;
	gap: 12rpx;
	align-items: center;
}

.ghost-btn {
	height: 92rpx;
	line-height: 92rpx;
	border-radius: 12rpx;
	border: 1rpx solid #d1d5db;
	background: #ffffff;
	color: #374151;
	font-size: 28rpx;
}

.primary-btn {
	margin-top: 10rpx;
	width: 100%;
	border: none;
	border-radius: 12rpx;
	height: 92rpx;
	line-height: 92rpx;
	background: linear-gradient(90deg, #06c15f, #10b981);
	color: #ffffff;
	font-size: 30rpx;
	font-weight: 700;
	box-shadow: 0 10rpx 22rpx rgba(6, 193, 95, 0.26);
}

.third-party-btn {
	margin-top: 14rpx;
	width: 100%;
	height: 92rpx;
	line-height: 92rpx;
	border-radius: 12rpx;
	border: 1rpx solid #07c160;
	background: #ffffff;
	color: #07c160;
	font-size: 30rpx;
	font-weight: 600;
}

.mock-code {
	margin-top: 16rpx;
	font-size: 22rpx;
	color: #b45309;
	text-align: left;
}
