<view class="login-page">
  <view class="hero">
    <view class="wechat-logo">微</view>
    <view class="brand-title">景区预约</view>
    <view class="brand-sub">让出行预约更简单</view>
  </view>

  <view class="auth-card">
    <view class="mode-switch">
      <view class="mode-pill {{mode==='login' ? 'active' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
      <view class="mode-pill {{mode==='register' ? 'active' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
    </view>

    <view class="field">
      <text class="field-label">手机号</text>
      <input class="field-input" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" />
    </view>

    <view wx:if="{{mode==='register'}}" class="register-stepper">
      <view class="step {{registerStep===1 ? 'active' : (registerStep>1 ? 'done' : '')}}">1. 验证手机号</view>
      <view class="step-line"></view>
      <view class="step {{registerStep===2 ? 'active' : ''}}">2. 完善资料</view>
    </view>

    <view wx:if="{{mode==='register' && registerStep===1}}" class="code-row">
      <view class="field code-field">
        <text class="field-label">验证码</text>
        <input class="field-input" placeholder="输入验证码" value="{{code}}" bindinput="onCodeInput" />
      </view>
      <button class="code-btn" bindtap="sendCode">获取验证码</button>
    </view>

    <view wx:if="{{mode==='register' && registerStep===1}}" class="register-actions">
      <button class="primary-btn" bindtap="nextRegisterStep">下一步</button>
    </view>

    <view wx:if="{{mode==='register' && registerStep===2}}" class="field">
      <text class="field-label">昵称</text>
      <input class="field-input" placeholder="输入你的昵称" value="{{nickname}}" bindinput="onNicknameInput" />
    </view>

    <view wx:if="{{mode==='register' && registerStep===2}}" class="field">
      <text class="field-label">姓名</text>
      <input class="field-input" placeholder="请输入真实姓名" value="{{fullName}}" bindinput="onFullNameInput" />
    </view>

    <view wx:if="{{mode==='register' && registerStep===2}}" class="field">
      <text class="field-label">身份证号</text>
      <input class="field-input" placeholder="请输入身份证号" value="{{idCardNo}}" bindinput="onIdCardNoInput" />
    </view>

    <view wx:if="{{mode==='register' && registerStep===2}}" class="field">
      <text class="field-label">密码</text>
      <input class="field-input" password placeholder="请设置登录密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view wx:if="{{mode==='register' && registerStep===2}}" class="register-actions dual">
      <button class="ghost-btn" bindtap="prevRegisterStep">上一步</button>
      <button class="primary-btn" bindtap="submit">注册并登录</button>
    </view>

    <view wx:if="{{mode==='login' && loginMethod==='password'}}" class="field">
      <text class="field-label">密码</text>
      <input class="field-input" password placeholder="请输入密码" value="{{password}}" bindinput="onPasswordInput" />
    </view>

    <view wx:if="{{mode==='login'}}" class="method-tip" bindtap="toggleLoginMethod">
      <text wx:if="{{loginMethod==='password'}}">可使用验证码登录</text>
      <text wx:else>可使用密码登录</text>
    </view>

    <view wx:if="{{mode==='login' && loginMethod==='code'}}" class="code-row">
      <view class="field code-field">
        <text class="field-label">验证码</text>
        <input class="field-input" placeholder="输入验证码" value="{{code}}" bindinput="onCodeInput" />
      </view>
      <button class="code-btn" bindtap="sendCode">获取验证码</button>
    </view>

    <button wx:if="{{mode==='login'}}" class="primary-btn" bindtap="submit">登录</button>
    <button
      wx:if="{{mode==='login'}}"
      class="third-party-btn"
      bindtap="submitWechatThirdPartyLogin"
      disabled="{{oauthLoading}}"
      hover-class="none"
    >{{oauthLoading ? '正在微信登录...' : '微信一键登录（第三方）'}}</button>

    <view wx:if="{{mockCode}}" class="mock-code">模拟验证码: {{mockCode}}</view>
  </view>
</view>
