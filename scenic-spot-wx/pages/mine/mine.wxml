<view class="page">
  <view wx:if="{{noticeBar.visible}}" class="notice-bar">
    <view class="notice-content">
      <view class="notice-title">{{noticeBar.title}}</view>
      <view class="notice-text">{{noticeBar.content}}</view>
    </view>
    <button class="notice-btn" bindtap="closeNoticeBar">确认</button>
  </view>

  <view class="card profile-card">
    <view class="avatar-wrap" bindtap="goProfile">
      <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar">{{profile.nickname ? profile.nickname.slice(0, 1) : '游'}}</view>
    </view>
    <view class="profile-meta">
      <view class="nickname">{{profile.nickname}}</view>
      <view class="sub">角色: {{profile.roleText}} <text wx:if="{{profile.phone}}"> · 手机: {{profile.phone}}</text></view>
      <view class="entry" bindtap="goProfile">点击头像进入资料编辑</view>
    </view>
    <view class="arrow" bindtap="goProfile">></view>
  </view>

  <view class="section-switch card">
    <view class="switch-pill {{section==='orders' ? 'active' : ''}}" data-section="orders" bindtap="onSectionChange">我的订单</view>
    <view class="switch-pill {{section==='aftersale' ? 'active' : ''}}" data-section="aftersale" bindtap="onSectionChange">售后服务</view>
  </view>

  <view wx:if="{{section==='orders'}}">
    <scroll-view class="tabs" scroll-x>
      <view class="tab-row">
        <view
          wx:for="{{orderTabs}}"
          wx:key="key"
          class="tab {{activeOrderTab===item.key?'active':''}}"
          data-key="{{item.key}}"
          bindtap="onOrderTabTap"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>

    <view class="card order" wx:for="{{orders}}" wx:key="orderNo" data-orderno="{{item.orderNo}}" bindtap="goOrderDetail">
      <view class="order-main">
        <image class="ticket-cover" src="{{item.ticketImageUrl || defaultTicketImage}}" mode="aspectFill" />
        <view class="order-body">
          <view class="line between">
            <view class="order-no">{{item.orderNo}}</view>
            <view class="status {{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="line ticket-name">{{item.ticketName}}</view>
          <view class="line">出行日期 {{item.visitDate}} · 时段 {{item.timeslotId}}</view>
          <view class="line amount">实付 ¥{{item.amountYuanText}}</view>
        </view>
      </view>
      <view class="op-row">
        <button wx:if="{{item.status==='UNPAID'}}" class="mini primary" data-orderno="{{item.orderNo}}" catchtap="payNow" loading="{{processingOrderNo===item.orderNo}}" disabled="{{processingOrderNo===item.orderNo}}">{{processingOrderNo===item.orderNo ? '支付中...' : '去支付'}}</button>
        <view class="right-actions">
          <button class="mini danger" data-orderno="{{item.orderNo}}" catchtap="deleteOrder">删除订单</button>
          <button wx:if="{{item.status==='PAID' || item.status==='USED'}}" class="mini" data-orderno="{{item.orderNo}}" catchtap="applyAftersale">申请售后</button>
        </view>
      </view>
    </view>

    <view wx:if="{{!orders.length}}" class="empty">暂无订单</view>
  </view>

  <view wx:if="{{section==='aftersale'}}">
    <view class="card">
      <view class="title">售后记录</view>
      <scroll-view class="status-tabs" scroll-x>
        <view class="tab-row">
          <view wx:for="{{aftersaleStatusTabs}}" wx:key="key" class="tab {{activeAftersaleStatus===item.key?'active':''}}" data-key="{{item.key}}" bindtap="onAftersaleStatusTabTap">{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="record" wx:for="{{aftersales}}" wx:key="reqNo">
        <view class="row between">
          <view class="req">{{item.reqNo}}</view>
          <view class="tag {{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="row">订单 {{item.orderNo}} · {{item.reqTypeText}}</view>
        <view class="row note">原因: {{item.reason || '无'}}</view>
      </view>
      <view wx:if="{{!aftersales.length}}" class="empty">暂无售后记录</view>
    </view>
  </view>
</view>
