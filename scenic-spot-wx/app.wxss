page {
  background: #f3f5f8;
  color: #1f2937;
}

.page {
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 41, 55, 0.08);
}

.title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.btn {
  background: #0f766e;
  color: #fff;
  border-radius: 12rpx;
  border: none;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
}

.input {
  border: 1rpx solid #d1d5db;
  border-radius: 10rpx;
  padding: 12rpx;
  margin-bottom: 12rpx;
  background: #fff;
}
